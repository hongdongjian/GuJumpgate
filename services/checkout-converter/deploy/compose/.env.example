# Copy to `.env` and customize. Values here override docker-compose defaults.

# 强烈建议设置非空，作为应用层鉴权。
CHECKOUT_CONVERTER_API_KEY=replace-me

# 暴露给宿主的应用端口
CHECKOUT_CONVERTER_PORT=18080

# 应用调优
MAX_OUTBOUND_CONCURRENCY=200
SESSION_MAX_CLIENTS=400
REQUEST_TIMEOUT_SECONDS=30
IMPERSONATE_BROWSER=chrome136
LOG_LEVEL=INFO
